{
  "name": "@kanban/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && cp dist/index.html dist/404.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview --port 4173",
    "e2e": "node e2e/smoke.mjs && node e2e/interactions.mjs && node e2e/offline.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@hookform/resolvers": "^5.0.0",
    "@kanban/shared": "workspace:*",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.120.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.0",
    "dompurify": "^3.2.0",
    "i18next": "^25.0.0",
    "marked": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-i18next": "^16.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "playwright": "^1.65.0"
  }
}
